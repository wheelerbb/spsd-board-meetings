---
layout: layouts/base.njk
title: "School Board Meetings — South Portland School Department"
pageScript: |
  function filterYear(year, btn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.year-section').forEach(sec => {
      sec.style.display = (year === 'all' || sec.dataset.year === year) ? '' : 'none';
    });
  }
---

<div class="hero">
  <div class="hero-eyebrow">South Portland School Department</div>
  <h1>School Board<br>Meeting Archive</h1>
  <p>Agendas, supporting materials, video recordings, and searchable transcripts for every School Board meeting.</p>
  <div style="margin-top: 1.5rem; font-size: .85rem; color: var(--gold-light); max-width: 600px; margin-left: auto; margin-right: auto; line-height: 1.5; padding: 1.25rem; background: rgba(200,150,62,.1); border-radius: 6px; border: 1px solid var(--gold);">
    <strong>Community Resource & AI Disclosure:</strong> This is a community-built resource and not an official SPSD website. Summaries are AI-generated and may contain errors; please defer to official materials and videos as the source of truth.
  </div>
</div>

<div class="filter-bar">
  <span class="filter-label">School Year</span>
  <button class="filter-btn active" onclick="filterYear('all',this)">All</button>
  {% for sy in years %}
  <button class="filter-btn" onclick="filterYear('{{ sy }}',this)">{{ sy }}</button>
  {% endfor %}
</div>

<main class="main" id="meetingList">
  {% for sy in years %}
  <section class="year-section" data-year="{{ sy }}">
    <div class="year-label">{{ sy }} School Year</div>
    <div class="meetings-grid">
      {% for m in meetings | where("school_year", sy) | sort(true, false, "date") %}
      <a href="{{ ('/meetings/' + m.slug + '/') | url }}" class="meeting-card">
        <div class="card-top">
          <div class="card-date">{{ m.display_date }}</div>
          <div class="card-badge" data-type="{{ m.type }}">{{ m.type }}</div>
        </div>
        <div class="card-body">
          <div class="card-title">{{ m.title }}</div>
          <div class="card-topics">{{ m.topics | join(" · ") }}</div>
        </div>
        <div class="card-footer">
          <span class="card-icon-link">
            <svg class="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="12" height="12" rx="1.5"/><path d="M5 6h6M5 9h4"/></svg>
            {{ m.doc_count }} docs
          </span>
          {% if m.has_video %}
          <span class="card-icon-link">
            <svg class="icon" viewBox="0 0 16 16" fill="currentColor"><path d="M8 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2zm-1 4l4 2-4 2V6z"/></svg>
            Video
          </span>
          {% endif %}
          {% if m.has_transcript %}
          <span class="card-icon-link">
            <svg class="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4h12M2 8h8M2 12h5"/></svg>
            Transcript
          </span>
          {% elif not m.stub %}
          <span class="card-icon-link">
            <svg class="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4h12M2 8h8M2 12h5"/></svg>
            Highlights
          </span>
          {% else %}
          <span class="card-icon-link" style="opacity:.35; cursor:default;">
            <svg class="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4h12M2 8h8M2 12h5"/></svg>
            No transcript
          </span>
          {% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
</main>

