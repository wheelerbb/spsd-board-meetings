---
layout: layouts/base.njk
title: "SPSD Topics Index"
permalink: "/topics/index.html"
---

<div class="hero">
  <div class="hero-inner">
    <h1>Topics</h1>
    <div class="disclosure-notice">
      Select a topic below to trace its evolution, view key resolutions, and see summaries of perspectives from the Board, Administration, Staff, and Citizens.
    </div>
  </div>
</div>

<main class="main">
  <div class="topics-grid">
    {% for topic in all_topics %}
    <a href="{{ ('/topics/' + topic | slugify + '/') | url }}" class="topic-card">
      <h2>{{ topic }}</h2>
      <div class="topic-card-summary">
        {{ topic_summaries[topic].current_status if topic_summaries[topic] else "No summary available." }}
      </div>
      <div class="topic-explore-cta">
        Explore Evolution
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>
    </a>
    {% endfor %}
  </div>
</main>
