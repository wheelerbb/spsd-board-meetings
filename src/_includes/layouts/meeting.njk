---
layout: layouts/base.njk
---

<div class="meeting-header">
  <div class="header-inner">
    <h1>{{ heading | safe }}</h1>
    <div class="meeting-meta">
      <div class="meta-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="12" height="11" rx="1.5"/><path d="M2 7h12M5 1v4M11 1v4"/></svg>
        {{ day_of_week }}, {{ display_date }}
      </div>
      <div class="meta-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 2"/></svg>
        {{ time }} · {{ location }}
      </div>
      {% if duration %}
      <div class="meta-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 2"/></svg>
        Duration: {{ duration }}
      </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="page-body">

  <div class="main-column">
    
    {# 1. VOTES & ACTIONS #}
    {% if votes and votes.length %}
    <div class="content-block">
      <div class="section-head">Votes &amp; Actions</div>
      <table class="vote-table">
        <thead>
          <tr>
            <th>Motion</th>
            <th>Result</th>
            <th>Moved / 2nd</th>
          </tr>
        </thead>
        <tbody>
          {% for vote in votes %}
          <tr>
            <td>{{ vote.motion }}</td>
            <td>
              <div class="vote-result">
                <span class="vote-chip {{ vote.result | lower }}">{{ vote.result }}</span>
                <span class="vote-count">{{ vote.count }}</span>
              </div>
            </td>
            <td class="vote-tally">{{ vote.moved_2nd }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {# 2. MEETING SUMMARY #}
    {% if summary and summary.length %}
    <div class="content-block">
      <div class="section-head">Meeting Summary</div>
      <div class="summary-intro">
        <ul class="summary-bullets">
          {% for item in summary %}
          <li><strong>{{ item.topic }}:</strong> {{ item.text }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% elif stub %}
    <div class="content-block">
      <div class="section-head">Meeting Summary</div>
      <div class="summary-intro">
        Summary and transcript highlights for this meeting are coming soon. Meeting materials and video recording are available via the sidebar links.
      </div>
    </div>
    {% endif %}

    {# 3. TIMELINE #}
    {% if timeline and timeline.length %}
    <div class="content-block">
      <div class="section-head">Transcript Highlights with Timestamps</div>
      <p style="font-size:.82rem; color:var(--muted); line-height:1.6; margin-bottom:1.5rem; font-style:italic;">Note: Transcripts are generated from video auto-captions. While highly accurate, they are non-official and do not meet State Archivist record-keeping requirements.</p>
      <ul class="timeline">
        {% for item in timeline %}
        <li class="tl-item">
          <div class="tl-time">
            {% if has_video %}
            <a href="{{ video_url }}#t={{ item.seconds }}s" target="_blank" class="tl-time-btn">
              <svg viewBox="0 0 16 16"><path d="M8 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2zm-1.5 4l4 2-4 2V6z"/></svg>
              {{ item.time }}
            </a>
            {% else %}
            <span class="tl-time-btn" style="background:var(--warm-gray); color:var(--muted); cursor:default;">{{ item.time }}</span>
            {% endif %}
          </div>
          <div class="tl-body">
            <div class="tl-topic">{{ item.topic }}</div>
            <div class="tl-desc">{{ item.desc }}</div>
          </div>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {{ content | safe }}
  </div>

  <aside class="sidebar">

    {% if has_video %}
    <div class="sidebar-card">
      <div class="sidebar-card-head">📹 Video Recording</div>
      <div class="sidebar-card-body">
        <p style="font-size:.8rem; color:var(--muted); margin-bottom:.8rem; line-height:1.5;">
          Video recordings provided by <a href="https://vimeo.com/spctv" target="_blank" style="color:var(--gold);">SPC TV</a>. Use the play buttons in the highlights section to jump to specific agenda items.
        </p>
        <a href="{{ video_url }}" target="_blank" class="video-btn">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2zm-1.5 4l4 2-4 2V6z"/></svg>
          Watch on Vimeo
        </a>
      </div>
    </div>
    {% endif %}

    <div class="sidebar-card">
      <div class="sidebar-card-head">📄 Meeting Materials</div>
      <div class="sidebar-card-body">
        {# Identify standard documents by keyword #}
        {% set agendaDoc = null %}{% set packetDoc = null %}{% set minDoc = null %}
        {% for d in docs %}
          {% set labelLower = d.label | lower %}
          {% if 'agenda' in labelLower and not agendaDoc %}{% set agendaDoc = d %}
          {% elif 'packet' in labelLower and not packetDoc %}{% set packetDoc = d %}
          {% elif 'minutes' in labelLower and not minDoc %}{% set minDoc = d %}
          {% endif %}
        {% endfor %}

        {# 1. Agenda #}
        {% if agendaDoc %}
        <a href="{{ agendaDoc.url }}" target="_blank" class="doc-link">
          <div class="doc-icon {{ agendaDoc.type | docClass }}">{{ agendaDoc.type | docIcon }}</div>
          <div><div class="doc-name">{{ agendaDoc.label }}</div>{% if agendaDoc.size %}<div class="doc-size">{{ agendaDoc.size }}</div>{% endif %}</div>
        </a>
        {% else %}
        <div class="doc-link" style="cursor:default; opacity:.5;">
          <div class="doc-icon none">AGD</div><div class="doc-name none">Agenda not found</div>
        </div>
        {% endif %}

        {# 2. Packet #}
        {% if packetDoc %}
        <a href="{{ packetDoc.url }}" target="_blank" class="doc-link">
          <div class="doc-icon {{ packetDoc.type | docClass }}">{{ packetDoc.type | docIcon }}</div>
          <div><div class="doc-name">{{ packetDoc.label }}</div>{% if packetDoc.size %}<div class="doc-size">{{ packetDoc.size }}</div>{% endif %}</div>
        </a>
        {% else %}
        <div class="doc-link" style="cursor:default; opacity:.5;">
          <div class="doc-icon none">PKT</div><div class="doc-name none">Meeting Packet not found</div>
        </div>
        {% endif %}

        {# 3. Minutes #}
        {% if minDoc %}
        <a href="{{ minDoc.url }}" target="_blank" class="doc-link">
          <div class="doc-icon {{ minDoc.type | docClass }}">{{ minDoc.type | docIcon }}</div>
          <div><div class="doc-name">{{ minDoc.label }}</div>{% if minDoc.size %}<div class="doc-size">{{ minDoc.size }}</div>{% endif %}</div>
        </a>
        {% else %}
        <div class="doc-link" style="cursor:default; opacity:.5;">
          <div class="doc-icon none">MIN</div><div class="doc-name none">Minutes not found</div>
        </div>
        {% endif %}

        {# 4. Additional Materials #}
        {% for d in docs %}
          {% if d != agendaDoc and d != packetDoc and d != minDoc %}
          <a href="{{ d.url }}" target="_blank" class="doc-link">
            <div class="doc-icon {{ d.type | docClass }}">{{ d.type | docIcon }}</div>
            <div><div class="doc-name">{{ d.label }}</div>{% if d.size %}<div class="doc-size">{{ d.size }}</div>{% endif %}</div>
          </a>
          {% endif %}
        {% endfor %}
        
        <p style="font-size:.7rem; color:var(--muted); margin-top:.9rem; line-height:1.5;">All materials at the <a href="https://www.spsdme.org/page/school-board" target="_blank" style="color:var(--gold);">SPSD Board page</a>.</p>
      </div>
    </div>

    {% if board_attendance %}
    <div class="sidebar-card">
      <div class="sidebar-card-head">👥 Meeting Attendance</div>
      <div class="sidebar-card-body">
        
        <div class="att-section-label">Board</div>
        <div class="att-grid">
          {% for member in board_attendance %}
            {% if member.role == 'Board' or not member.role %}
            <div class="att-item">
              <span class="att-status {{ member.status | lower }}"></span>
              {{ member.name }}
            </div>
            {% endif %}
          {% endfor %}
        </div>

        {% set hasStudentReps = false %}
        {% for member in board_attendance %}{% if member.role == 'Student Rep' %}{% set hasStudentReps = true %}{% endif %}{% endfor %}
        
        {% if hasStudentReps %}
        <div class="att-section-label">Student Reps</div>
        <div class="att-grid">
          {% for member in board_attendance %}
            {% if member.role == 'Student Rep' %}
            <div class="att-item">
              <span class="att-status {{ member.status | lower }}"></span>
              {{ member.name }}
            </div>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}

      </div>
    </div>
    {% endif %}

    {% if has_transcript and drive_url %}
    <div class="sidebar-card">
      <div class="sidebar-card-head">🗂 Transcript (Google Drive)</div>
      <div class="sidebar-card-body">
        <p style="font-size:.8rem; color:var(--muted); margin-bottom:.8rem; line-height:1.5;">
          Full verbatim transcript on Google Drive.{% if not stub %} Timestamps in the summary above link directly to the video player.{% else %} Timestamped highlights will be added to this page.{% endif %}
        </p>
        <a href="{{ drive_url }}" target="_blank" class="drive-btn">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 11l4-7 4 7M6 11h8l-4-7"/></svg>
          Open in Google Drive
        </a>
      </div>
    </div>
    {% endif %}

    <div style="background:#fff; border:1px solid var(--rule); border-radius:6px; padding:1rem 1.1rem;">
      <div style="font-size:.7rem; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-bottom:.8rem;">Navigate Meetings</div>
      {% if prev %}
      <a href="{{ ('/meetings/' + prev.slug + '/') | url }}" style="display:flex; align-items:center; gap:.5rem; font-size:.82rem; color:var(--navy); text-decoration:none; padding:.5rem 0; border-bottom:1px solid var(--rule);">← {{ prev.label }}</a>
      {% else %}
      <span style="display:flex; align-items:center; gap:.5rem; font-size:.82rem; color:var(--muted); padding:.5rem 0; border-bottom:1px solid var(--rule);">← Oldest meeting</span>
      {% endif %}
      {% if next %}
      <a href="{{ ('/meetings/' + next.slug + '/') | url }}" style="display:flex; align-items:center; gap:.5rem; font-size:.82rem; color:var(--navy); text-decoration:none; padding:.5rem 0; justify-content:flex-end;">{{ next.label }} →</a>
      {% else %}
      <span style="display:flex; align-items:center; gap:.5rem; font-size:.82rem; color:var(--muted); padding:.5rem 0; justify-content:flex-end;">Next meeting TBD</span>
      {% endif %}
    </div>

  </aside>

  {# Disclosure Block (ordered last on mobile via CSS) #}
  <div class="disclosure-block" style="grid-column: 1 / -1; border-top: 2px solid var(--gold); padding-top: 2rem; margin-top: 1rem;">
    <div style="font-size: .9rem; color: var(--text); line-height: 1.6; background: #fff; padding: 1.5rem; border-radius: 6px; border: 1px solid var(--gold);">
      <h4 style="font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; margin-bottom: .75rem; color: var(--gold);"><strong>Community Resource & AI Disclosure</strong></h4>
      This is a community-built resource and not an official South Portland School Department (SPSD) website. Meeting summaries and highlights are AI-generated and may contain errors. <strong>For the official record, please defer to the video recordings and official meeting materials.</strong>
    </div>
  </div>

</div>
