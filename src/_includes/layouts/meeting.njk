---
layout: layouts/base.njk
---

<div class="meeting-header">
  <div class="header-inner">
    <h1>{{ heading | safe }}</h1>
    <div class="meeting-meta">
      <div class="meta-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="12" height="11" rx="1.5"/><path d="M2 7h12M5 1v4M11 1v4"/></svg>
        {{ day_of_week }}, {{ display_date }}
      </div>
      <div class="meta-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 2"/></svg>
        {{ time }} · {{ location }}
      </div>
      {% if duration %}
      <div class="meta-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 2"/></svg>
        Duration: {{ duration }}
      </div>
      {% endif %}
    </div>

    {%- set nav = meetings | meetingNav(page.fileSlug) -%}
    {%- set prev = nav.prev -%}
    {%- set next = nav.next -%}
    <div class="meeting-nav">
      {% if next %}
      <a href="{{ ('/meetings/' + next.slug + '/') | url }}" class="meeting-nav-link">← Older: {{ next.label }}</a>
      {% else %}
      <span class="meeting-nav-muted">← Oldest meeting</span>
      {% endif %}
      {% if prev %}
      <a href="{{ ('/meetings/' + prev.slug + '/') | url }}" class="meeting-nav-link">Newer: {{ prev.label }} →</a>
      {% else %}
      <span class="meeting-nav-muted">Most recent meeting →</span>
      {% endif %}
    </div>
  </div>
</div>

<div class="page-body">

  <div class="main-column">

    {# 1. VOTES & ACTIONS #}
    {% if votes and votes.length %}
    <div class="content-block">
      <div class="section-head">Votes &amp; Actions{% if votes_source %} <div class="source-badge {% if votes_source == 'Minutes' %}source-badge--minutes{% else %}source-badge--transcript{% endif %}"><b>SOURCE:</b> {{ votes_source }}</div>{% endif %}</div>
      <table class="vote-table">
        <thead>
          <tr>
            <th>Motion</th>
            <th>Result</th>
            <th>Moved / 2nd</th>
          </tr>
        </thead>
        <tbody>
          {% for vote in votes %}
          <tr>
            <td>{{ vote.motion }}</td>
            <td>
              <div class="vote-result">
                {% set _r = vote.result | lower %}
                {% if _r == 'pass' or _r == 'passed' or _r == 'approved' %}{% set _chipClass = 'pass' %}
                {% elif _r == 'fail' or _r == 'failed' or _r == 'denied' %}{% set _chipClass = 'fail' %}
                {% else %}{% set _chipClass = _r %}{% endif %}
                <span class="vote-chip {{ _chipClass }}">{{ vote.result }}</span>
                <span class="vote-count">{{ vote.count }}</span>
              </div>
            </td>
            <td class="vote-tally">{{ vote.moved_2nd | movedShort }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    {# 2. MEETING SUMMARY #}
    {% if summary and summary.length %}
    <div class="content-block">
      <div class="section-head">Meeting Summary</div>
      <div class="summary-intro">
        <ul class="summary-bullets">
          {% for item in summary %}
          <li><strong>{{ item.topic }}:</strong> {{ item.text }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% elif stub %}
    <div class="content-block">
      <div class="section-head">Meeting Summary</div>
      <div class="summary-intro">
        Summary and transcript highlights for this meeting are coming soon. Meeting materials and video recording are available via the sidebar links.
      </div>
    </div>
    {% endif %}

    {# 3. TIMELINE #}
    {% if timeline and timeline.length %}
    <div class="content-block">
      <div class="section-head">Detailed Proceedings</div>
      <p class="tl-caption">Note: Transcripts are generated from video auto-captions. While highly accurate, they are non-official and do not meet State Archivist record-keeping requirements.</p>
      <ul class="timeline">
        {% for item in timeline %}
        <li class="tl-item">
          <div class="tl-time">
            {% if has_video %}
            <a href="{{ video_url }}#t={{ item.seconds }}s" target="_blank" class="tl-time-btn">
              <svg viewBox="0 0 16 16"><path d="M4 2l10 6-10 6V2z"/></svg>
              {{ item.seconds | secondsToTime }}
            </a>
            {% else %}
            <span class="tl-time-btn tl-time-btn--disabled">{{ item.seconds | secondsToTime }}</span>
            {% endif %}
          </div>
          <div class="tl-body">
            <div class="tl-topic">{{ item.topic }}</div>
            <div class="tl-desc">{{ item.desc }}</div>
            {% if item.children and item.children.length %}
            <ul class="tl-children">
              {% for child in item.children %}
              <li class="tl-child">
                <div class="tl-child-meta">
                  {% if has_video %}
                  <a href="{{ video_url }}#t={{ child.seconds }}s" target="_blank" class="tl-time-btn tl-time-btn--sm">
                    <svg viewBox="0 0 16 16"><path d="M4 2l10 6-10 6V2z"/></svg>
                    {{ child.seconds | secondsToTime }}
                  </a>
                  {% endif %}
                  <span class="tl-child-speaker">{{ child.speaker }}</span>
                </div>
                <div class="tl-child-text">{{ child.text }}</div>
              </li>
              {% endfor %}
            </ul>
            {% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {{ content | safe }}
  </div>

  <aside class="sidebar">

    {# 1. MEETING MATERIALS #}
    <div class="sidebar-card">
      <div class="sidebar-card-head">📄 Meeting Materials</div>
      <div class="sidebar-card-body">
        {% set agendaDoc = null %}{% set packetDoc = null %}{% set minDoc = null %}{% set vttDoc = null %}
        {% for d in docs %}
          {% set labelLower = d.label | lower %}
          {% if ('agenda' in labelLower or d.type == 'agenda') and not agendaDoc %}{% set agendaDoc = d %}
          {% elif ('packet' in labelLower or d.type == 'packet') and not packetDoc %}{% set packetDoc = d %}
          {% elif ('minutes' in labelLower or d.type == 'minutes') and not minDoc %}{% set minDoc = d %}
          {% elif (d.type == 'transcript' or 'spboe_' in labelLower) and not vttDoc %}{% set vttDoc = d %}
          {% endif %}
        {% endfor %}

        {% if agendaDoc %}
        <a href="{{ agendaDoc.url }}" target="_blank" class="doc-link">
          <div class="doc-icon {{ agendaDoc | fileTypeClass }}">{{ agendaDoc | fileTypeLabel }}</div>
          <div><div class="doc-name">{{ agendaDoc.label }}</div>{% if agendaDoc.size %}<div class="doc-size">{{ agendaDoc.size }}</div>{% endif %}</div>
        </a>
        {% endif %}

        {% if packetDoc %}
        <a href="{{ packetDoc.url }}" target="_blank" class="doc-link">
          <div class="doc-icon {{ packetDoc | fileTypeClass }}">{{ packetDoc | fileTypeLabel }}</div>
          <div><div class="doc-name">{{ packetDoc.label }}</div>{% if packetDoc.size %}<div class="doc-size">{{ packetDoc.size }}</div>{% endif %}</div>
        </a>
        {% else %}
        <div class="doc-link doc-link--placeholder">
          <div class="doc-icon none">PKT</div><div class="doc-name none">Meeting Packet not found</div>
        </div>
        {% endif %}

        {% if minDoc %}
        <a href="{{ minDoc.url }}" target="_blank" class="doc-link">
          <div class="doc-icon {{ minDoc | fileTypeClass }}">{{ minDoc | fileTypeLabel }}</div>
          <div><div class="doc-name">{{ minDoc.label }}</div>{% if minDoc.size %}<div class="doc-size">{{ minDoc.size }}</div>{% endif %}</div>
        </a>
        {% else %}
        <div class="doc-link doc-link--placeholder">
          <div class="doc-icon none">MIN</div><div class="doc-name none">Minutes not found</div>
        </div>
        {% endif %}

        {% if vttDoc %}
        <a href="{{ vttDoc.url }}" target="_blank" class="doc-link">
          <div class="doc-icon vtt">VTT</div>
          <div><div class="doc-name">Meeting Transcript</div></div>
        </a>
        {% else %}
        <div class="doc-link doc-link--placeholder">
          <div class="doc-icon none">VTT</div><div class="doc-name none">Transcript not found</div>
        </div>
        {% endif %}

        {% for d in docs %}
          {% set isStandard = false %}
          {% if agendaDoc and d.url == agendaDoc.url %}{% set isStandard = true %}{% endif %}
          {% if packetDoc and d.url == packetDoc.url %}{% set isStandard = true %}{% endif %}
          {% if minDoc and d.url == minDoc.url %}{% set isStandard = true %}{% endif %}
          {% if vttDoc and d.url == vttDoc.url %}{% set isStandard = true %}{% endif %}
          {% if not isStandard %}
          <a href="{{ d.url }}" target="_blank" class="doc-link">
            <div class="doc-icon {{ d | fileTypeClass }}">{{ d | fileTypeLabel }}</div>
            <div><div class="doc-name">{{ d.label }}</div>{% if d.size %}<div class="doc-size">{{ d.size }}</div>{% endif %}</div>
          </a>
          {% endif %}
        {% endfor %}

        <p class="sidebar-foot">All materials at the <a href="https://www.spsdme.org/page/school-board" target="_blank">SPSD Board page</a>.</p>
      </div>
    </div>

    {# 2. MEETING ATTENDANCE #}
    {% if board_attendance and not stub %}
    <div class="sidebar-card">
      <div class="sidebar-card-head">👥 Meeting Attendance{% if attendance_source %} <div class="source-badge {% if attendance_source == 'Minutes' %}source-badge--minutes{% else %}source-badge--transcript{% endif %}"><b>SOURCE:</b> {{ attendance_source }}</div>{% endif %}</div>
      <div class="sidebar-card-body">
        <div class="att-section-label">BOARD</div>
        <div class="att-grid">
          {% for member in board_attendance %}
            {% if member.role == 'Board' or not member.role %}
            <div class="att-item">
              <span class="att-status {{ member.status | lower }}"></span>
              {{ member.name }}
            </div>
            {% endif %}
          {% endfor %}
        </div>

        {% set hasStudentReps = false %}
        {% for member in board_attendance %}{% if member.role == 'Student Rep' %}{% set hasStudentReps = true %}{% endif %}{% endfor %}

        {% if hasStudentReps %}
        <div class="att-section-label">STUDENT REPS</div>
        <div class="att-grid">
          {% for member in board_attendance %}
            {% if member.role == 'Student Rep' %}
            <div class="att-item">
              <span class="att-status {{ member.status | lower }}"></span>
              {{ member.name }}
            </div>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {# 3. VIDEO RECORDING #}
    {% if has_video %}
    <div class="sidebar-card">
      <div class="sidebar-card-head">📹 Video Recording</div>
      <div class="sidebar-card-body">
        <p class="sidebar-note">Video recordings provided by <a href="https://vimeo.com/spctv" target="_blank">SPC TV</a>. Use the play buttons in the highlights section to jump to specific agenda items.</p>
        <a href="{{ video_url }}" target="_blank" class="video-btn">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2zm-1.5 4l4 2-4 2V6z"/></svg>
          Watch on Vimeo
        </a>
      </div>
    </div>
    {% endif %}

    {% if has_transcript and drive_url %}
    <div class="sidebar-card">
      <div class="sidebar-card-head">🗂 Transcript (Google Drive)</div>
      <div class="sidebar-card-body">
        <p class="sidebar-note">Full verbatim transcript on Google Drive.{% if not stub %} Timestamps in the summary above link directly to the video player.{% else %} Timestamped highlights will be added to this page.{% endif %}</p>
        <a href="{{ drive_url }}" target="_blank" class="drive-btn">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 11l4-7 4 7M6 11h8l-4-7"/></svg>
          Open in Google Drive
        </a>
      </div>
    </div>
    {% endif %}

  </aside>

</div>
