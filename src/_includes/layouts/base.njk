<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
</head>
<body>

<nav>
  <a href="{{ '/' | url }}" class="nav-logo">
    <div class="nav-logo-mark">SP</div>
    <div>
      <div class="nav-logo-text">South Portland Schools</div>
      <div class="nav-logo-sub">School Board Meetings</div>
    </div>
  </a>
  <div class="nav-links">
    <a href="{{ '/meetings/' | url }}" class="nav-link">Meeting Summaries</a>
    <a href="{{ '/topics/' | url }}" class="nav-link" style="color:var(--gold); font-weight:700;">Topics Index</a>
  </div>
</nav>

{{ content | safe }}

<footer>
  <p><strong>Community Resource:</strong> This is a community-built resource and not an official SPSD website.</p>
  <p><strong>AI Disclosure:</strong> Summaries are AI-generated and may contain errors; defer to official materials as the source of truth.</p>
  <p class="footer-small">Contact: <a href="mailto:sopoforward@gmail.com">sopoforward@gmail.com</a> · <a href="{{ '/status/' | url }}">Data Status Dashboard</a></p>
</footer>

{% if pageScript %}
<script>{{ pageScript | safe }}</script>
{% endif %}
</body>
</html>
