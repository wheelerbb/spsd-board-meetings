<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
</head>
<body>

<nav>
  <a href="{{ '/' | url }}" class="nav-logo">
    <div class="nav-logo-mark">SP</div>
    <div>
      <div class="nav-logo-text">South Portland Schools</div>
      <div class="nav-logo-sub">BoE Proceedings Digest</div>
    </div>
  </a>
  <div class="nav-links">
    <a href="{{ '/meetings/' | url }}" class="nav-link">Meetings</a>
    <a href="{{ '/topics/' | url }}" class="nav-link" style="color:var(--gold); font-weight:700;">Topics</a>
  </div>
</nav>

{{ content | safe }}

<footer>
  <div class="footer-disclosure">
    <div class="footer-disclosure-heading">Community Resource &amp; AI Disclosures</div>
    This is a community-built resource and not an official South Portland School Department (SPSD) website.<br>
    Meeting summaries and highlights are AI-generated and may contain errors.<br>
    <strong>For the official record, please defer to the video recordings and official meeting materials.</strong>
  </div>
  <p class="footer-small">Contact: <a href="mailto:sopoforward@gmail.com">sopoforward@gmail.com</a> · <a href="{{ '/status/' | url }}">Data Status Dashboard</a> · <a href="{{ '/processing-log/' | url }}">Processing Log</a></p>
</footer>

{% if pageScript %}
<script>{{ pageScript | safe }}</script>
{% endif %}
<script data-goatcounter="https://wheelerbb.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>
</body>
</html>
