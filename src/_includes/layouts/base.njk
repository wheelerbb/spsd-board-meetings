<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
</head>
<body>

<nav>
  <a href="{{ '/' | url }}" class="nav-logo">
    <div class="nav-logo-mark">SP</div>
    <div>
      <div class="nav-logo-text">South Portland Schools</div>
      <div class="nav-logo-sub">School Board Meetings</div>
    </div>
  </a>
  {% if breadcrumb %}
  <div class="breadcrumb">
    <a href="{{ '/' | url }}">All Meetings</a>
    <span>›</span>
    <span>{{ breadcrumb }}</span>
  </div>
  {% else %}
  <div class="nav-links">
    <a href="{{ '/topics/' | url }}" class="nav-link" style="color:var(--gold); font-weight:700;">Topics Index</a>
    <a href="https://www.spsdme.org" class="nav-link">District Site</a>
    <a href="https://www.spsdme.org/page/school-board" class="nav-link">Board Page</a>
    <a href="{{ '/status/' | url }}" class="nav-link">Status</a>
  </div>
  {% endif %}
</nav>

{{ content | safe }}

<footer>
  <p class="footer-label"><strong>Community Resource</strong></p>
  <p>This is a community-built resource and not an official SPSD website.</p>
  <p class="footer-label"><strong>AI Disclosure</strong></p>
  <p>Summaries are AI-generated and may contain errors; defer to official materials as the source of truth. Contact: <a href="mailto:sopoforward@gmail.com">sopoforward@gmail.com</a></p>
  <p class="footer-small">Linked materials hosted by SPSD · Videos on Vimeo (SPC TV) · <a href="{{ '/status/' | url }}">Data Status Dashboard</a></p>
</footer>

{% if pageScript %}
<script>{{ pageScript | safe }}</script>
{% endif %}
</body>
</html>
