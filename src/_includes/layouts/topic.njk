---
layout: layouts/base.njk
---

<div class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">Topic Explorer</div>
    <h1>{{ topic }}</h1>
  </div>
</div>

<main class="main main-topic">

  <div class="topic-summary-box">
    <div class="topic-status-label">Current Status &amp; Core Perspectives</div>
    <div class="summary-text">
      {{ topic_summary | safe | replace('\n', '<br>') }}
    </div>

    {% set recent_votes = [] %}
    {% for m in collections.all | sort(true, false, "date") %}
      {% if m.data.topics and topic in m.data.topics %}
        {% if m.data.votes %}
          {% for v in m.data.votes %}
            {% if topic | lower in v.motion | lower %}
              {% set _ = recent_votes.push({ vote: v, date: m.data.display_date, url: m.url }) %}
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {% if recent_votes.length > 0 %}
    <div class="topic-votes">
      <div class="topic-votes-label">Key Resolutions &amp; Votes</div>
      <table class="vote-table vote-table--topic">
        <thead>
          <tr>
            <th>Date</th>
            <th>Motion</th>
            <th>Result</th>
          </tr>
        </thead>
        <tbody>
          {% for item in recent_votes %}
          <tr>
            <td class="vote-date-cell"><a href="{{ item.url | url }}">{{ item.date }}</a></td>
            <td>{{ item.vote.motion }}</td>
            <td><span class="vote-chip {{ item.vote.result | lower }}">{{ item.vote.result }}</span></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </div>

  <div class="evolution-timeline">
    <h3 class="evolution-section-title">Evolution of Discussion</h3>

    {% for m in collections.all | sort(true, false, "data.date") %}
      {% if m.data.topics and topic in m.data.topics %}
      <div class="evolution-item">
        <div class="evolution-date">{{ m.data.display_date }}</div>
        <h4 class="evolution-meeting-title"><a href="{{ m.url | url }}">{{ m.data.title }}</a></h4>

        <div class="evolution-body">
          {% if m.data.summary %}
            {% for s in m.data.summary %}
              {% if topic | lower in s.topic | lower or topic | lower in s.text | lower %}
                <div class="evolution-bullet">
                  <span class="evolution-topic-label">{{ s.topic }}</span>
                  {{ s.text }}
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>

        {% set related_docs = [] %}
        {% if m.data.docs %}
          {% for d in m.data.docs %}
            {% if topic | lower in d.label | lower %}
              {% set _ = related_docs.push(d) %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if related_docs.length > 0 %}
        <div class="evolution-docs">
          {% for d in related_docs %}
          <a href="{{ d.url }}" target="_blank" class="doc-link">
            <div class="doc-icon {{ d.type | docClass }}">{{ d.type | docIcon }}</div>
            {{ d.label }}
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endif %}
    {% endfor %}
  </div>

</main>
