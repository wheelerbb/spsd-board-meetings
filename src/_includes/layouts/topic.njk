---
layout: layouts/base.njk
---

<div class="topic-hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">Topic Explorer</div>
    <h1>{{ topic }}</h1>
  </div>
</div>

<main class="main" style="padding-top: 0; background: #fdfdfd;">

  <div class="topic-summary-box">
    <div class="topic-status-label">Current Status &amp; Core Perspectives</div>
    <div class="summary-text" style="font-size: 1.1rem; line-height: 1.7; color: var(--text); font-family: 'DM Sans', sans-serif;">
      {{ topic_summary | safe | replace('\n', '<br>') }}
    </div>
    
    {% set recent_votes = [] %}
    {% for m in meetings | sort(true, false, "date") %}
      {% if m.data.topics and topic in m.data.topics %}
        {% if m.data.votes %}
          {% for v in m.data.votes %}
            {% if topic | lower in v.motion | lower %}
              {% set _ = recent_votes.push({ vote: v, date: m.data.display_date, url: m.url }) %}
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {% if recent_votes.length > 0 %}
    <div style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--rule);">
      <h4 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1.5rem; color: var(--muted); font-weight: 800;">Key Resolutions &amp; Votes</h4>
      <table class="vote-table" style="font-size: 0.85rem; background: #fafafa; border-radius: 6px;">
        <thead>
          <tr>
            <th>Date</th>
            <th>Motion</th>
            <th>Result</th>
          </tr>
        </thead>
        <tbody>
          {% for item in recent_votes %}
          <tr>
            <td style="white-space: nowrap; font-weight: 700;"><a href="{{ item.url | url }}" style="color:var(--navy);">{{ item.date }}</a></td>
            <td style="line-height: 1.5;">{{ item.vote.motion }}</td>
            <td><span class="vote-chip {{ item.vote.result | lower }}">{{ item.vote.result }}</span></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </div>

  <div class="evolution-timeline" style="max-width: 900px; margin: 5rem auto;">
    <h3 style="font-family:'Playfair Display',serif; font-size: 2.2rem; font-weight: 800; margin-bottom: 4rem; text-align: center; color: var(--navy);">Evolution of Discussion</h3>
    
    {% for m in meetings | sort(true, false, "date") %}
      {% if m.data.topics and topic in m.data.topics %}
      <div class="evolution-item">
        <div class="evolution-date">{{ m.data.display_date }}</div>
        <h4 style="font-family: 'Playfair Display', serif; font-size: 1.4rem; margin-bottom: 1rem;"><a href="{{ m.url | url }}" style="color:var(--navy); text-decoration:none;">{{ m.data.title }}</a></h4>
        
        <div style="color: var(--text); line-height: 1.65; font-size: 1.05rem;">
          {% if m.data.summary %}
            {% for s in m.data.summary %}
              {% if topic | lower in s.topic | lower or topic | lower in s.text | lower %}
                <div style="margin-bottom: 0.75rem;">
                  <strong style="color:var(--gold); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">{{ s.topic }}:</strong> {{ s.text }}
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>

        {% set related_docs = [] %}
        {% if m.data.docs %}
          {% for d in m.data.docs %}
            {% if topic | lower in d.label | lower %}
              {% set _ = related_docs.push(d) %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if related_docs.length > 0 %}
        <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
          {% for d in related_docs %}
          <a href="{{ d.url }}" target="_blank" class="doc-link" style="padding: 5px 10px; font-size: 0.72rem; border-color: var(--rule); background: #fff;">
            <div class="doc-icon {{ d.type | docClass }}">{{ d.type | docIcon }}</div>
            {{ d.label }}
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endif %}
    {% endfor %}
  </div>

</main>

