---
layout: layouts/base.njk
---

<div class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">Topic Explorer</div>
    <h1>{{ topic }}</h1>
  </div>
</div>

<main class="main main-topic">

  {% set ts = topic_summaries[topic] %}

  {# Meetings tagged with this topic, newest first — the single source list reused below
     by the votes table, the meeting-history timeline, and the overview date-linker. #}
  {% set topic_meetings = [] %}
  {% for m in collections.meetings | sort(true, false, "date") %}
    {% if m.data.topics and topic in m.data.topics %}
      {% set _ = topic_meetings.push({ date: m.data.display_date, url: (m.url | url), data: m.data }) %}
    {% endif %}
  {% endfor %}

  <div class="topic-summary-box">

    {% if ts and ts.current_status %}
    <div class="topic-section">
      <div class="topic-status-label">Current Status</div>
      <div class="summary-text">{{ ts.current_status | paragraphs | linkMeetingDates(topic_meetings) | safe }}</div>
    </div>
    {% endif %}

    {% if ts and ts.overview %}
    <div class="topic-section">
      <div class="topic-section-label">Overview</div>
      <ul class="summary-bullets">
        {% for point in ts.overview %}
        <li>{{ point | escape | linkMeetingDates(topic_meetings) | safe }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if ts and ts.perspectives %}
    <div class="topic-section">
      <div class="topic-section-label">Perspectives</div>
      <div class="perspectives-grid">
        {% for group, points in ts.perspectives %}
        <div class="perspective-card">
          <div class="perspective-card-label">{{ group }}</div>
          <ul class="summary-bullets">
            {% for point in points %}
            <li>{{ point | escape | linkMeetingDates(topic_meetings) | safe }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% set recent_votes = [] %}
    {% for tm in topic_meetings %}
      {% if tm.data.votes %}
        {% for v in tm.data.votes %}
          {% if v.motion | topicMatch(topic) %}
            {% set _ = recent_votes.push({ vote: v, date: tm.date, url: tm.url }) %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}

    {% if recent_votes.length > 0 %}
    <div class="topic-votes">
      <div class="topic-votes-label">Key Resolutions &amp; Votes</div>
      <div class="table-scroll">
        <table class="vote-table vote-table--topic">
          <thead>
            <tr>
              <th>Date</th>
              <th>Motion</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody>
            {% for item in recent_votes %}
            <tr>
              <td class="vote-date-cell"><a href="{{ item.url }}">{{ item.date }}</a></td>
              <td>{{ item.vote.motion }}</td>
              <td><span class="vote-chip {{ item.vote.result | voteChipClass }}">{{ item.vote.result }}</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endif %}
  </div>

  <div class="evolution-timeline">
    <h3 class="evolution-section-title">Meeting History</h3>

    {% for tm in topic_meetings %}

      {% set relevant_bullets = [] %}
      {% set evidence_indices = tm.data.topic_evidence[topic] if tm.data.topic_evidence else none %}
      {% if evidence_indices and tm.data.summary %}
        {% for idx in evidence_indices %}
          {% if tm.data.summary[idx] %}
            {% set _ = relevant_bullets.push(tm.data.summary[idx]) %}
          {% endif %}
        {% endfor %}
      {% elif tm.data.summary %}
        {% for s in tm.data.summary %}
          {% if topic | lower in s.topic | lower or s.topic | lower in topic | lower %}
            {% set _ = relevant_bullets.push(s) %}
          {% endif %}
        {% endfor %}
      {% endif %}

      <div class="evolution-item">
        <div class="evolution-date">{{ tm.date }}</div>
        <h4 class="evolution-meeting-title"><a href="{{ tm.url }}">{{ tm.data.title }}</a></h4>

        <div class="evolution-body">
          {% if relevant_bullets.length > 0 %}
            {% for s in relevant_bullets %}
              <div class="evolution-bullet">
                <span class="evolution-topic-label">{{ s.topic }}</span>
                {{ s.text }}
              </div>
            {% endfor %}
          {% elif tm.data.blurb %}
            <div class="evolution-blurb">{{ tm.data.blurb | safe }}</div>
          {% endif %}
        </div>

        {% if tm.data.docs and tm.data.docs.length > 0 %}
        <a href="{{ tm.url }}" class="evolution-materials-link">View {{ tm.data.docs.length }} meeting material{% if tm.data.docs.length != 1 %}s{% endif %} &rarr;</a>
        {% endif %}
      </div>

    {% endfor %}
  </div>

</main>
